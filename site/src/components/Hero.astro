---
// Starlight Hero override: the landing gets a split hero with real app screenshots; other splash pages get a plain title.
import { Image } from "astro:assets";
import { LinkButton } from "@astrojs/starlight/components";
import { APP_URL } from "../../../shared/brand.ts";
import mapLight from "../assets/shots/map-m-light.webp";
import mapDark from "../assets/shots/map-m-dark.webp";
import mascot from "../assets/questie-light.svg";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const landing = Astro.locals.starlightRoute.id === "";
---

<div class:list={["q-hero", { "q-hero--landing": landing }]}>
  <div class="copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    {actions.length > 0 && (
      <div class="actions">
        {actions.map(({ text, link, variant, attrs }) => (
          <LinkButton href={link.replace("$APP_URL", APP_URL)} variant={variant} {...attrs}>{text}</LinkButton>
        ))}
      </div>
    )}
  </div>
  {landing && (
    <div class="shots" aria-hidden="true">
      <figure class="shot map">
        <Image src={mapLight} alt="" widths={[300, 600]} sizes="300px" loading="eager" fetchpriority="high" class="dark:sl-hidden" />
        <Image src={mapDark} alt="" widths={[300, 600]} sizes="300px" loading="lazy" class="light:sl-hidden" />
      </figure>
      <img class="mascot" src={mascot.src} alt="" width="96" height="107" />
    </div>
  )}
</div>

<style>
  .q-hero { display: grid; gap: 2rem; padding-block: 1rem 2.5rem; }
  .copy { display: grid; gap: 1.25rem; align-content: center; }
  h1 {
    font-family: var(--q-display); font-weight: 700; line-height: 1.05; margin: 0;
    font-size: clamp(2.8rem, 7vw, 4.2rem); color: var(--sl-color-white);
  }
  .tagline { font-size: clamp(1.1rem, 2.2vw, 1.3rem); line-height: 1.55; color: var(--sl-color-gray-2); max-width: 34ch; margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem 1rem; align-items: center; }

  .q-hero--landing { min-height: min(40rem, calc(100dvh - var(--sl-nav-height) - 2rem)); align-items: center; }
  .shots { position: relative; height: 30rem; max-width: 30rem; width: 100%; justify-self: center; }
  .shot {
    position: absolute; margin: 0; background: var(--q-surface); padding: .5rem; border-radius: 8px;
    border: 1px solid var(--q-line); box-shadow: var(--q-shadow);
  }
  .shot::before { /* tape */
    content: ""; position: absolute; top: -.7rem; left: 50%; width: 5.5rem; height: 1.4rem; translate: -50% 0; rotate: -4deg;
    background: var(--q-tape);
  }
  .shot :global(img) { vertical-align: top; width: 100%; height: auto; border-radius: 4px; }
  .map { width: 17rem; left: 50%; top: .75rem; translate: -55% 0; rotate: -2.5deg; }
  .map :global(img) { aspect-ratio: 390 / 640; object-fit: cover; object-position: top; }
  .mascot { position: absolute; width: 7rem; height: auto; right: 0; bottom: 1rem; rotate: 7deg; filter: drop-shadow(0 10px 12px rgb(0 0 0 / .18)); }

  @media (min-width: 50rem) {
    .q-hero--landing { grid-template-columns: 1.1fr 1fr; gap: 3rem; }
  }
  @media (max-width: 30rem) {
    .shots { height: 26rem; }
    .map { width: 14.5rem; }
    .mascot { width: 5.5rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .shot { animation: drop .7s cubic-bezier(.2, .8, .2, 1) both; }
    .mascot { animation: hop .6s cubic-bezier(.2, .8, .2, 1) .35s both; }
    @keyframes drop { from { opacity: 0; transform: translateY(1.5rem); } }
    @keyframes hop { from { opacity: 0; transform: translateY(1rem) scale(.9); } }
  }
</style>
