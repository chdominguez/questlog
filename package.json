{
  "name": "questie",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build && npm run build:server",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "validate": "tsx scripts/validate.ts",
    "mcp": "tsx mcp/server.ts",
    "server": "npm run build:server && npm start",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server && KATA=1 vite build --ssr server/kata-child.ts --outDir dist-server/kata",
    "build:mobile": "vite build --mode mobile",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:android": "npm run cap:sync && cap run android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:assets": "npx @capacitor/assets generate --assetPath resources",
    "site:schema": "tsx scripts/schema-ref.ts",
    "site:demo": "VITE_DEMO=1 vite build --base /demo/ --outDir site/public/demo --emptyOutDir",
    "site:build": "npm run site:schema && npm run site:demo && npm --prefix site run build",
    "site:dev": "npm run site:schema && npm --prefix site run dev",
    "stripe:setup": "tsx scripts/stripe-setup.ts"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@better-auth/api-key": "1.7.18",
    "@capacitor-firebase/messaging": "8.6.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capgo/capacitor-social-login": "8.7.7",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@revenuecat/purchases-capacitor": "14.1.0",
    "better-auth": "1.7.18",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.4.17",
    "firebase": "12.19.0",
    "hono": "^4.13.17",
    "marked": "^18.2.0",
    "mermaid": "^12.3.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "stripe": "23.1.0",
    "sucrase": "^3.35.1",
    "ts-fsrs": "^6.0.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.22",
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "^1.65.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "private": true,
  "description": "A personal, gamified learning platform: courses as quests, spaced repetition, AI-graded answers.",
  "license": "AGPL-3.0-only"
}
