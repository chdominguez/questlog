{
  "name": "questlog",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit -p . && vite build",
    "start": "vite build && tsx --env-file-if-exists=.env server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "validate": "tsx scripts/validate.ts",
    "mcp": "tsx mcp/server.ts"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/server": "^2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.4.17",
    "hono": "^4.13.17",
    "marked": "^18.2.0",
    "mermaid": "^12.3.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "sucrase": "^3.35.1",
    "ts-fsrs": "^6.0.0",
    "zod": "^4.6.7",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "private": true,
  "description": "A personal, gamified learning platform: courses as quests, spaced repetition, AI-graded answers.",
  "license": "MIT"
}
