# Copy to .env (gitignored). Every variable: https://questie.app/self-host/config/
APP_URL=http://localhost:8787
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# ADMIN_EMAILS=you@example.com
# SIGNUP=open

# Mail (verification, magic link, reset). Unset: links are logged.
# RESEND_API_KEY=
# EMAIL_FROM=Questie <hello@example.com>

# Social sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_BUNDLE_ID=

# AI: grading, course builder, mock exams
# ANTHROPIC_API_KEY=sk-ant-...
# Narration
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICES=voice-id-1,voice-id-2

# Billing: both set = credits on, else AI is not metered
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# REVENUECAT_WEBHOOK_AUTH=

# Study reminders: npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@example.com
# FCM_SERVICE_ACCOUNT=

# Backups (Litestream)
# LITESTREAM_BUCKET=
# LITESTREAM_PATH=
# LITESTREAM_ENDPOINT=
# LITESTREAM_REGION=
# LITESTREAM_ACCESS_KEY_ID=
